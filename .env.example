# Copy to .env and fill in what you have. Everything works without LLM keys
# (rules-only enrichment, deterministic explanations); the agent needs at least one.

ENV=development
DATABASE_URL=postgresql+psycopg://rolecall:rolecall@localhost:5433/rolecall
WEB_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=["you@example.com"]

# Free LLM providers, tried in this order. Fill any subset.
LLM_PROVIDER_ORDER=["groq","gemini","cerebras","openrouter","ollama"]
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
# Local models on your own machine, e.g. http://localhost:11434/v1
OLLAMA_BASE_URL=

# Email digests via any SMTP server (Gmail app password, Brevo free tier, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Production only (infra/docker-compose.prod.yml)
POSTGRES_PASSWORD=
API_DOMAIN=
