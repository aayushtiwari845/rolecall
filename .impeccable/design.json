      "css": ".ds-btn-outline{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px;border:1px solid var(--rule-strong,#a6bcab);border-radius:6px;background:transparent;color:var(--ink,#0b1a11);font:400 14px/1 Archivo,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background .15s}.ds-btn-outline:hover{background:var(--panel-2,#e9f0e9)}.ds-btn-outline:focus-visible{outline:2px solid var(--amber,#f4c430);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet tertiary action.",
      "html": "<button class=\"ds-btn-ghost\">Try it without signing in</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;height:40px;padding:0 16px;border:0;border-radius:6px;background:transparent;color:var(--ink-2,#33473b);font:400 14px/1 Archivo,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background .15s,color .15s}.ds-btn-ghost:hover{background:var(--panel-2,#e9f0e9);color:var(--ink,#0b1a11)}.ds-btn-ghost:focus-visible{outline:2px solid var(--amber,#f4c430);outline-offset:2px}"
    },
    {
      "name": "Toggle Set",
      "kind": "chip",
      "refersTo": "toggle",
      "description": "Squared option toggles that replace chips in filters and preferences.",
      "html": "<div class=\"ds-toggles\"><button class=\"ds-toggle\" aria-pressed=\"true\">Internship</button><button class=\"ds-toggle\" aria-pressed=\"false\">New grad</button><button class=\"ds-toggle\" aria-pressed=\"false\">Remote</button></div>",
      "css": ".ds-toggles{display:flex;flex-wrap:wrap;gap:6px}.ds-toggle{height:32px;padding:0 10px;border:1px solid var(--rule-strong,#a6bcab);border-radius:3px;background:transparent;color:var(--ink-2,#33473b);font:400 14px/1 Archivo,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:color .15s,border-color .15s}.ds-toggle:hover{border-color:var(--ink-3,#55695d);color:var(--ink,#0b1a11)}.ds-toggle[aria-pressed=true]{border-color:var(--ink,#0b1a11);background:var(--ink,#0b1a11);color:var(--bg,#f3f7f2)}.ds-toggle:focus-visible{outline:2px solid var(--amber,#f4c430);outline-offset:2px}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Text field with a label caption and amber focus border.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Location</span><input class=\"ds-input\" placeholder=\"Bengaluru, remote\"></label>",
      "css": ".ds-field{display:grid;gap:8px}.ds-field-label{font:600 11px/1 Archivo,sans-serif;letter-spacing:.08em;text-transform:uppercase;font-variation-settings:'wdth' 88;color:var(--ink-2,#33473b)}.ds-input{height:40px;padding:0 12px;border:1px solid var(--rule-strong,#a6bcab);border-radius:6px;background:var(--panel,#fff);color:var(--ink,#0b1a11);font:400 14px Archivo,sans-serif;outline:none;caret-color:var(--amber,#f4c430);transition:border-color .15s}.ds-input::placeholder{color:var(--ink-3,#55695d)}.ds-input:focus{border-color:var(--amber,#f4c430)}"
    },
    {
      "name": "Top Navigation",
      "kind": "nav",
      "refersTo": "",
      "description": "App header nav; the active item sits on a 3px amber bar over the bottom rule.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-link\" aria-current=\"page\" href=\"#\">Scorecard</a><a class=\"ds-nav-link\" href=\"#\">Search</a><a class=\"ds-nav-link\" href=\"#\">Tracker</a><span class=\"ds-nav-live\"><i></i><b>214</b> new today</span></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:4px;height:56px;padding:0 16px;border-bottom:1px solid var(--rule,#d2ded4);background:var(--bg,#f3f7f2);font-family:Archivo,sans-serif}.ds-nav-link{position:relative;padding:8px 12px;font-size:14px;color:var(--ink-2,#33473b);text-decoration:none;transition:color .15s}.ds-nav-link:hover{color:var(--ink,#0b1a11)}.ds-nav-link:focus-visible{outline:2px solid var(--amber,#f4c430);outline-offset:2px}.ds-nav-link[aria-current=page]{font-weight:600;color:var(--ink,#0b1a11)}.ds-nav-link[aria-current=page]::after{content:'';position:absolute;left:12px;right:12px;bottom:-11px;height:3px;background:var(--amber,#f4c430)}.ds-nav-live{margin-left:auto;display:inline-flex;align-items:center;gap:8px;font-size:14px;color:var(--ink-2,#33473b)}.ds-nav-live i{width:8px;height:8px;border-radius:50%;background:var(--green,#0c7440)}.ds-nav-live b{font:700 20px/.85 'Big Shoulders',sans-serif;color:var(--ink,#0b1a11)}"
    },
    {
      "name": "Job Row",
      "kind": "custom",
      "refersTo": "job-row",
      "description": "One role as a scorecard row: score, role and reasons, level and pay. Saved draws the pen ring.",
      "html": "<article class=\"ds-row\"><div class=\"ds-score\"><span class=\"ds-score-n\">82</span><span class=\"ds-score-l\">match</span><svg class=\"ds-ring\" viewBox=\"0 0 100 70\" preserveAspectRatio=\"none\" fill=\"none\"><path d=\"M52 6C27 4 6 15 5 33c-1 18 21 31 48 31 26 0 43-12 42-29C94 18 76 7 50 8c-12 .4-22 3-29 8\" stroke=\"var(--pen,#1d4fd8)\" stroke-width=\"2.6\" stroke-linecap=\"round\" vector-effect=\"non-scaling-stroke\"/></svg></div><div><a class=\"ds-row-title\" href=\"#\">ML Infrastructure Intern</a><p class=\"ds-row-meta\"><b>Acme</b> · Bengaluru · 3h ago</p><ul class=\"ds-reasons\"><li>Python, PyTorch matched</li><li>Internship level</li><li class=\"warn\">Asks for 2 years</li></ul></div><div class=\"ds-row-side\"><span class=\"ds-label\">Intern</span><span class=\"ds-pay\">&#8377;60k/mo</span></div></article>",
      "css": ".ds-row{display:grid;grid-template-columns:auto 1fr auto;gap:8px 24px;align-items:start;padding:20px 0;border-top:1px solid var(--rule,#d2ded4);font-family:Archivo,sans-serif;font-feature-settings:'tnum' 1,'lnum' 1}.ds-score{position:relative;display:inline-flex;flex-direction:column;align-items:center;width:3.2rem}.ds-score-n{font:800 2.6rem/.85 'Big Shoulders',sans-serif;color:var(--green,#0c7440)}.ds-score-l{margin-top:4px;font:600 .6rem/1 Archivo,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3,#55695d)}.ds-ring{position:absolute;top:-12px;left:-14px;width:calc(100% + 28px);height:calc(100% + 22px);pointer-events:none}.ds-row-title{font-size:17px;font-weight:600;color:var(--ink,#0b1a11);text-decoration:none;text-decoration-color:var(--amber,#f4c430)}.ds-row-title:hover{text-decoration-line:underline}.ds-row-title:focus-visible{outline:2px solid var(--amber,#f4c430);outline-offset:2px}.ds-row-meta{margin:4px 0 0;font-size:14px;color:var(--ink-2,#33473b)}.ds-row-meta b{font-weight:500;color:var(--ink,#0b1a11)}.ds-reasons{display:flex;flex-wrap:wrap;gap:4px 16px;margin:10px 0 0;padding:0;list-style:none;font-size:13px}.ds-reasons li{display:flex;align-items:baseline;gap:6px;color:var(--ink-2,#33473b)}.ds-reasons li::before{content:'';flex:none;width:6px;height:6px;border-radius:50%;background:var(--green,#0c7440);transform:translateY(-1px)}.ds-reasons li.warn{color:var(--red,#c11f34)}.ds-reasons li.warn::before{background:var(--red,#c11f34)}.ds-row-side{display:flex;gap:12px;align-items:baseline;font-size:14px}.ds-label{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-2,#33473b)}.ds-pay{font-weight:500;color:var(--amber-text,#7a5600)}"
    },
    {
      "name": "Scoreboard",
      "kind": "custom",
      "refersTo": "scoreboard",
      "description": "The dark board of live counts, plates divided by seams; dark in both themes.",
      "html": "<section class=\"ds-board\"><div class=\"ds-board-top\"><span><i></i>Live index · crawled 12m ago</span><span>1,204 companies</span></div><div class=\"ds-plates\"><div class=\"ds-plate\"><span class=\"ds-num big\">48,312</span><span class=\"ds-cap\">Open tech roles right now</span></div><div class=\"ds-plate\"><span class=\"ds-num\">9,870</span><span class=\"ds-cap\">Open in India or remote-India</span></div></div></section>",
      "css": ".ds-board{background:var(--board,#0a1d14);color:var(--chalk,#eef4ec);border-radius:6px;overflow:hidden;box-shadow:inset 0 1px 0 rgb(255 255 255/.04);font-family:Archivo,sans-serif}.ds-board-top{display:flex;justify-content:space-between;padding:12px 24px;border-bottom:1px solid var(--board-rule,#234634)}.ds-board-top span,.ds-cap{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--chalk-2,#a7c0b0);display:flex;align-items:center;gap:8px}.ds-board-top i{width:8px;height:8px;border-radius:50%;background:#45dd8c}.ds-plates{display:grid;grid-template-columns:1.4fr 1fr}.ds-plate{display:grid;align-content:end;gap:8px;padding:24px}.ds-plate+.ds-plate{border-left:1px solid var(--board-rule,#234634)}.ds-num{font:800 5.25rem/.85 'Big Shoulders',sans-serif;letter-spacing:-.01em;font-feature-settings:'tnum' 1,'lnum' 1;color:var(--chalk,#eef4ec)}.ds-num.big{font-size:8rem}"
    }
  ],
  "narrative": {
    "northStar": "The Live Innings",
    "overview": "Rolecall is a cricket scoreboard and a scorer's book. The scoreboard is the public face: a pitch-black green panel with chalk numerals set huge in a condensed sports face, counting the open index live. The scorer's book is where the user works: a cool white page with a double green margin rule down the left, every entry written on a hairline. Every role is a row of hard numbers (match score, level, pay, posted age), and state is marked the way a scorer marks it, by hand: a blue pen ring circles a saved score, a red strike runs through a dismissed or rejected role.\n\nDensity is high and tabular. Rows, not cards; rules, not boxes. Numerals carry the hierarchy, so headings and scores share one condensed uppercase voice while reading text stays in a plain, slightly narrowed grotesque. Colour is semantic before it is decorative: amber is the one call to action and the active marker, green is runs (strong fits, offers, live), red is wickets (warnings, dismissals, rejections). Dark mode is the stadium at night; the scoreboard panel stays dark in both themes.\n\nThe build refuses the job-board defaults: no logo-tile card grid, no pill chips, no search-bar hero.",
    "keyCharacteristics": [
      "Two materials: the dark scoreboard (`.board`, dark in both themes) and the ruled scorebook page.",
      "Lists are ruled rows sharing one column order: score, role and reasons, level and pay, actions.",
      "Condensed Big Shoulders numerals and uppercase headings; Archivo for everything read.",
      "Tabular, lining figures everywhere, set globally on `body`.",
      "State marked by hand: pen ring for saved, red strike for dismissed and rejected.",
      "Motion is a scoreboard flip, a ball rolling in from the left, a ring being drawn; all collapse under reduced motion."
    ],
    "rules": [
      {
        "name": "The Runs and Wickets Rule",
        "body": "Green means a good outcome, red means a dismissal or warning. Neither is ever used as decoration, brand colour or category coding.",
        "section": "colors"
      },
      {
        "name": "The One Amber Rule",
        "body": "Amber marks the single primary action and the current position (active nav, focus, selection). One amber-filled button per view region.",
        "section": "colors"
      },
      {
        "name": "The Neutrals Are Pitch Rule",
        "body": "Every neutral is tinted toward green (hue around 140 to 155). Do not introduce a pure grey.",
        "section": "colors"
      },
      {
        "name": "The Tabular Everything Rule",
        "body": "`tnum` and `lnum` are on globally; numbers in any column must align digit for digit.",
        "section": "typography"
      },
      {
        "name": "The Numerals Speak First Rule",
        "body": "On any row or board the biggest thing is a number, not a word.",
        "section": "typography"
      },
      {
        "name": "The Rules Not Shadows Rule",
        "body": "Rows and sections separate with 1px rules. A shadow appears only on something that floats over content or can be picked up.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** set every count, score and age in the score face with tabular figures, and let it be the largest element in its row or plate.",
      "**Do** build lists as ruled rows with a shared column order; reach for a card only when the entry is physically moved (the tracker slip).",
      "**Do** keep the scoreboard panel dark (`board`) in both themes, with chalk numerals and board-rule seams.",
      "**Do** mark saved with the pen ring and dismissed or rejected with a red strike, never with a badge.",
      "**Do** keep amber to the primary action, the current position and focus.",
      "**Do** honour reduced motion: every animation collapses to 1ms and rests in its visible state (no fill-mode start frames)."
    ],
    "donts": [
      "**Don't** build a card grid with logo tiles, pill chips or a search-bar hero.",
      "**Don't** use green or red for anything but runs and wickets.",
      "**Don't** introduce pure greys or a second accent hue.",
      "**Don't** separate rows with shadows or gaps where a 1px rule will do.",
      "**Don't** set reading text in the score face or in uppercase; uppercase belongs to the score face and to labels.",
      "**Don't** put a small uppercase label above a heading as a kicker; labels caption numerals, fields and columns."
    ]
  }
}